
# --- Connexion à PostgreSQL -------------------------------------------------
# Format : postgresql+psycopg2://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
#
# Dans Docker, HOTE = le NOM DU CONTENEUR de la base (voir `docker ps`) et PORT = 5432
# (le port INTERNE de PostgreSQL, pas le port publié sur votre machine).
# Exemple : base dans un conteneur nommé "bornes_db"
DATABASE_URL=postgresql+psycopg2://postgres:postgres@bornes_db:5432/bornes
# Exécution de l'API hors Docker (uvicorn sur votre machine) :
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bornes

# --- Réseau Docker partagé par la base, l'API et l'interface web -------------
# Nom du réseau Docker auquel est (ou sera) connecté le conteneur de la base.
DB_NETWORK=bornes_net

# --- CORS (développement uniquement) ------------------------------------------
# Origines autorisées à appeler l'API directement depuis un navigateur.
CORS_ORIGINS=http://localhost:8080,http://localhost:5500,http://127.0.0.1:5500
